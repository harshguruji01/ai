# ==============================================================================
# HARSHGURUJI AI — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Client Configuration (Public)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 2. Supabase Server Configuration (Privileged Server-Only)
# ------------------------------------------------------------------------------
# NEVER expose this key to browser code or prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 3. NVIDIA NIM API Integration (Server-Only)
# ------------------------------------------------------------------------------
# Get your API key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-...
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1

# Configured Models
NVIDIA_TEXT_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_IMAGE_MODEL=stabilityai/stable-diffusion-xl

# ------------------------------------------------------------------------------
# 4. Anti-Abuse & Rate Limiting Security (Server-Only)
# ------------------------------------------------------------------------------
# Cryptographically secure secret (at least 32 bytes) for HMAC-SHA256 guest hashing
# Generate via: openssl rand -hex 32
GUEST_ID_HMAC_SECRET=your_32_byte_random_hex_secret_here

# Reverse Proxy Trust Configuration:
# Options: 'cloudflare' | 'vercel' | 'standard' | 'direct'
TRUSTED_PROXY_CONFIGURATION=standard

# ------------------------------------------------------------------------------
# 5. Application Domain & Cross-Subdomain URLs (Public)
# ------------------------------------------------------------------------------
# The subdomain where HarshGuruJi AI is hosted
NEXT_PUBLIC_APP_URL=https://ai.webguruji.online

# The main website hosting the primary login & user accounts
NEXT_PUBLIC_MAIN_SITE_URL=https://webguruji.online

# Cross-Subdomain Cookie Domain (*.webguruji.online)
# Leave blank or set to 'localhost' during local development
NEXT_PUBLIC_COOKIE_DOMAIN=.webguruji.online
